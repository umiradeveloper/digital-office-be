# ── Database ── (MySQL lokal; buat dulu dengan: mysql -u root -p < prisma/setup-database.sql)
DATABASE_URL="mysql://digital:digital@localhost:3306/digital_office"

# ── Server ──
PORT=4000
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# ── JWT ── (ganti di produksi)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Storage dokumen ── (local disk; path relatif terhadap folder backend)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# ── SMTP ── dev: Mailpit (brew install mailpit → UI http://localhost:8025); produksi: server SMTP kantor
# Jika tidak ada SMTP yang berjalan, aplikasi tetap jalan — e-mail tercatat gagal & dicoba ulang.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Digital Office <no-reply@digital-office.local>"
NOTIF_MAX_ATTEMPTS=3

# ── Naskah dinas (kop surat & tanda tangan QR) ──
# Logo PNG untuk kop surat & laporan PDF (default: assets/umira-logo.png)
ORG_LOGO=assets/umira-logo.png
ORG_NAME="PT UMIRA"
ORG_ADDRESS="Alamat kantor Umira"
ORG_CONTACT="Telp. (021) 000-0000 · info@umira.co.id"
# Kunci HMAC tanda tangan QR — WAJIB diganti & dirahasiakan di produksi (jangan diubah setelah ada dokumen bertanda tangan)
SIGNATURE_SECRET=change-me-signature-secret

# ── Koneksi SuperApps (opsional) ──
# Jika diisi: user & role SuperApps disinkron otomatis, dan login dicek langsung ke SuperApps
# (email/username + password SuperApps). Pakai user MySQL READ-ONLY (cukup SELECT pada tabel users & role).
# Karakter khusus di password harus di-URL-encode (mis. @ → %40).
SUPERAPPS_DATABASE_URL=
# SUPERAPPS_DATABASE_URL="mysql://readonly_user:password@host:3306/superapps"
# Interval sinkron (menit); 0 = hanya saat start / manual
SUPERAPPS_SYNC_MINUTES=30
SUPERAPPS_SYNC_ON_START=true
# true = akun Vendor ikut aktif
SUPERAPPS_INCLUDE_VENDOR=false
SUPERAPPS_USERS_TABLE=users
SUPERAPPS_ROLE_TABLE=role
SUPERAPPS_DB_SSL=false
